# Root-level .gitignore for Zerodha Clone repository

# Environment variables & secrets (CRITICAL)
.env
.env*.local
.env.development
.env.production
.env.test
backend/.env
dashboard/.env
frontend/.env

# Dependencies
node_modules/
backend/node_modules/
dashboard/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build and production output
build/
dist/
dashboard/build/
frontend/build/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage and test output
coverage/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
